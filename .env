# TradingView Webhook Listener Configuration

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# ── Webhook Security ───────────────────────────────────────────────────────────
# Secret key for verifying TradingView webhook signatures (use a strong random key)
WEBHOOK_SECRET=iEzHCmllMTa9T85hHH6quFuGI48rkypx1q_nZ-1QByA
# Expected signature header name from TradingView
WEBHOOK_SIGNATURE_HEADER=X-TradingView-Signature
# Whether to verify webhook signatures (set to false for testing)
VERIFY_SIGNATURES=true

# ── Operation Mode ─────────────────────────────────────────────────────────────
# DRY_RUN=true: validate payloads only, no live orders executed
# DRY_RUN=false: execute real orders (requires BROKER_API_* configs)
DRY_RUN=true

# ── Paper Trading ──────────────────────────────────────────────────────────────
# Initial capital for paper trading (USD)
PAPER_CAPITAL=10000.0
# Journal file path for paper trades
PAPER_JOURNAL_PATH=data/paper_trades.jsonl
# Risk limits
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=2.0

# ── Broker Integration (Live Trading) ──────────────────────────────────────────
# Available brokers: simulate, binance, bybit, oanda
BROKER=simulate
# Broker-specific credentials (only needed if BROKER != simulate)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=

# ── MCP Integration ────────────────────────────────────────────────────────────
# Whether MCP integration is enabled
MCP_ENABLED=true
# Path to MCP server executable (if using local TradingView MCP)
MCP_SERVER_PATH=
# MCP server arguments (space-separated)
MCP_SERVER_ARGS=

# ── TradingView Alert Message Format ───────────────────────────────────────────
# TradingView sends: ticker, action (buy/sell/stop_buy/stop_sell), quantity, strategy parameters
# Example payload:
# {
#   "ticker": "BINANCE:BTCUSDT",
#   "action": "buy",
#   "quantity": 0.05,
#   "strategy": {
#     "name": "RSI_Divergence",
#     "parameters": {"rsi": 28, "ema": 50}
#   },
#   "timestamp": "2026-05-09T00:53:04Z",
#   "price": 62340.50
# }

# ── Monitoring & Alerting ───────────────────────────────────────────────────────
# Webhook metrics collection
ENABLE_METRICS=true
METRICS_PORT=9090
# Admin alert email (optional)
ALERT_EMAIL=
# Slack webhook URL for critical alerts (optional)
SLACK_WEBHOOK_URL=

# ── Logging ────────────────────────────────────────────────────────────────────
# Log format: json | console
LOG_FORMAT=console
# Log file path (empty = stdout only)
LOG_FILE=
# Maximum log file size in MB before rotation
LOG_MAX_BYTES=10485760
# Number of backup log files to keep
LOG_BACKUP_COUNT=5
# Generated on Sat May  9 00:57:42 +03 2026
